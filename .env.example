# Supabase — shared FreeWebsites project; IBE data lives in the `ibe` schema
NEXT_PUBLIC_SUPABASE_URL=https://nxhwqtqroyerbbklywyn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=ibe
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Its sha256 must be in private.ibe_admin_token (see supabase/freewebsites/).
SUPABASE_ADMIN_TOKEN=
SUPABASE_STORAGE_BUCKET=ibe-media
# Legacy: service-role key for the old standalone IBEWebsite project
SUPABASE_SERVICE_KEY=

# Admin
ADMIN_PASSWORD=your-admin-password
# Signs the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=

# Resend (contact form notification emails)
RESEND_API_KEY=

# Google Apps Script URL for contact form submissions
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
